{% extends 'base.html.twig' %}

{% block stylesheets %}
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
     <style>
        body {
            background-image: url('{{ asset('assets/FondoHomeRecitech.jpg') }}');
            background-size: cover;
            background-repeat: no-repeat;
            background-attachment: fixed;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="min-h-screen" style="background-image: url('{{ asset('assets/FondoHomeRecitech.jpg') }}'); background-size: cover; background-position: center;">
        <header class="sticky top-0 z-50 flex justify-between items-center p-4 bg-white shadow-md rounded-xl mx-5 mt-6">
            <div class="flex items-center space-x-2">
            <img src="{{ asset('assets/IconoRobot.png') }}" alt="Icono Robot" class="w-12 h-12">
            <h1 class="text-lg font-semibold text-gray-700">ReciTech</h1>
            </div>
            <nav class="flex items-center space-x-3 text-xs">
            <a href="/minevera" class="flex flex-col items-center">
                <img src="{{ asset('assets/iconos/nevera.png') }}" alt="Mi Nevera" class="w-8 h-8">
            </a>
            <a href="/tiporeceta" class="flex flex-col items-center">
                <img src="{{ asset('assets/iconos/libro-de-recetas.png') }}" alt="Recetas" class="w-8 h-8">
            </a>
            <span class="mx-2"></span>
            <a href="/perfil">
                <img src="{{ asset('assets/user.png') }}" alt="Foto de perfil" class="w-12 h-12 rounded-full border border-gray-300">
            </a>
            </nav>
        </header>

        <div class="container mx-auto p-6">
            <h1 class="text-4xl font-bold text-white mb-8 text-center">¡¡ Descubre Recetas Nuevas !!</h1>

            <!-- Tarjetas de recetas -->
            <div class="space-y-8">
                {% for receta in recetas %}
                    <a href="{{ path('ver_receta', {'id': receta.id}) }}" class="block transition-transform hover:scale-105">
                        <div class="flex flex-col md:flex-row items-center bg-white rounded-2xl shadow-lg p-8 cursor-pointer">
                            {% if receta.imagen %}
                                <img src="{{ asset('assets/fotorecetas/' ~ receta.imagen) }}"
                                     alt="{{ receta.nombre }}"
                                     class="w-full max-w-xs aspect-square md:w-40 md:h-40 object-cover rounded-xl mb-4 md:mb-0 md:mr-8"
                                     style="aspect-ratio: 1 / 1;">
                            {% else %}
                                <div class="w-full max-w-xs aspect-square md:w-40 md:h-40 bg-gray-200 rounded-xl flex items-center justify-center text-gray-400 text-lg mb-4 md:mb-0 md:mr-8"
                                     style="aspect-ratio: 1 / 1;">
                                    Sin foto
                                </div>
                            {% endif %}
                            <div class="flex-1 w-full">
                                <h2 class="text-2xl font-bold text-gray-800 mb-2 text-center md:text-left">{{ receta.nombre }}</h2>
                                <div class="flex flex-row justify-center md:justify-start items-center space-x-6">
                                    <div class="flex items-center">
                                        {% set color = 'bg-red-500' %}
                                        {% if receta.dificultad|lower == 'fácil' or receta.dificultad|lower == 'facil' %}
                                            {% set color = 'bg-green-500' %}
                                        {% elseif receta.dificultad|lower == 'media' %}
                                            {% set color = 'bg-yellow-400' %}
                                        {% endif %}
                                        <span class="w-5 h-5 {{ color }} rounded-full mr-2"></span>
                                        <span class="text-gray-700 text-lg">{{ receta.dificultad }}</span>
                                    </div>
                                    <div class="flex items-center">
                                        <img src="{{ asset('assets/iconos/reloj.png') }}" alt="Tiempo" class="w-5 h-5 mr-2" onerror="this.onerror=null;this.src='{{ asset('assets/iconos/reloj.jpg') }}';" />
                                        <span class="text-gray-700 text-lg">{{ receta.tiempo }} min</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </a>
                {% else %}
                    <div class="text-center text-gray-500">No hay recetas disponibles.</div>
                {% endfor %}
            </div>
        </div>

    </div>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/JSPaginaPrincipal.js') }}"></script>
{% endblock %}