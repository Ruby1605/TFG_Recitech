{% extends 'base.html.twig' %}

{% block stylesheets %}
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <style>
        body {
            background-image: url('{{ asset('assets/FondoHomeRecitech.jpg') }}');
            background-size: cover;
            background-repeat: no-repeat;
            background-attachment: fixed;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="min-h-screen" style="background-image: url('{{ asset('assets/FondoHomeRecitech.jpg') }}'); background-size: cover; background-position: center;">
        <header class="sticky top-0 z-50 flex justify-between items-center p-4 bg-white shadow-md rounded-xl mx-5 mt-6">
            <div class="flex items-center space-x-2">
                <img src="{{ asset('assets/IconoRobot.png') }}" alt="Icono Robot" class="w-12 h-12">
                <h1 class="text-lg font-semibold text-gray-700">ReciTech</h1>
            </div>
            <nav class="flex items-center text-xs">
                <div class="flex items-center space-x-3">
                    <a href="/home" class="flex flex-col items-center">
                        <img src="{{ asset('assets/iconos/casa.png') }}" alt="" class="w-8 h-8">
                    </a>
                    <a href="/minevera" class="flex flex-col items-center">
                        <img src="{{ asset('assets/iconos/nevera.png') }}" alt="Mi Nevera" class="w-8 h-8">
                    </a>
                    <a href="/tiporeceta" class="flex flex-col items-center">
                        <img src="{{ asset('assets/iconos/libro-de-recetas.png') }}" alt="Recetas" class="w-8 h-8">
                    </a>
                </div>
                <span class="mx-4"></span>
                <a href="/perfil">
                    <img src="{{ asset('assets/user.png') }}" alt="Foto de perfil" class="w-12 h-12 rounded-full border border-gray-300">
                </a>
            </nav>
        </header>

        <div class="container mx-auto p-6">
            <div class="flex flex-col md:flex-row items-center bg-white rounded-2xl shadow-lg p-8 max-w-3xl mx-auto">
                {% if receta.imagen %}
                    <img src="{{ asset('assets/fotorecetas/' ~ receta.imagen) }}"
                         alt="{{ receta.nombre }}"
                         class="w-full max-w-xs aspect-square md:w-60 md:h-60 object-cover rounded-xl mb-4 md:mb-0 md:mr-8"
                         style="aspect-ratio: 1 / 1;">
                {% else %}
                    <div class="w-full max-w-xs aspect-square md:w-60 md:h-60 bg-gray-200 rounded-xl flex items-center justify-center text-gray-400 text-lg mb-4 md:mb-0 md:mr-8"
                         style="aspect-ratio: 1 / 1;">
                        Sin foto
                    </div>
                {% endif %}
                <div class="flex-1 w-full">
                    <h2 class="text-3xl font-bold text-gray-800 mb-4 text-center md:text-left">{{ receta.nombre }}</h2>
                    <div class="mb-4">
                        <h3 class="font-semibold text-gray-700 mb-1">Valores Nutricionales</h3>
                        <ul class="list-disc list-inside text-gray-600 space-y-2">
                            <li><span class="font-semibold">Calorías:</span> {{ receta.calorias is defined ? receta.calorias ~ ' kcal' : 'N/A' }}</li>
                            <li><span class="font-semibold">Grasas:</span> {{ receta.grasas is defined ? receta.grasas ~ ' g' : 'N/A' }}</li>
                            <li><span class="font-semibold">Grasas saturadas:</span> {{ receta.grasas_saturadas is defined ? receta.grasas_saturadas ~ ' g' : 'N/A' }}</li>
                            <li><span class="font-semibold">Colesterol:</span> {{ receta.colesterol is defined ? receta.colesterol ~ ' mg' : 'N/A' }}</li>
                            <li><span class="font-semibold">Carbohidratos:</span> {{ receta.carbohidratos is defined ? receta.carbohidratos ~ ' g' : 'N/A' }}</li>
                            <li><span class="font-semibold">Azúcares:</span> {{ receta.azucares is defined ? receta.azucares ~ ' g' : 'N/A' }}</li>
                            <li><span class="font-semibold">Proteína:</span> {{ receta.proteinas is defined ? receta.proteinas ~ ' g' : 'N/A' }}</li>
                        </ul>
                    </div>
                    <div class="flex justify-end mt-6">
                        <a href="{{ path('ver_receta', {'id': receta.id}) }}"
                           class="px-6 py-2 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg shadow transition duration-200">
                            Volver a la receta
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}