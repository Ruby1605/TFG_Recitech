{% extends 'base.html.twig' %}

{# Título de la página #}
{% block title %}Nuevo Ingrediente{% endblock %}

{% block body %}
    {# Fondo de pantalla fijo para toda la página #}
    <div class="position-fixed top-0 start-0 w-100 h-100 min-vh-100 min-vw-100"
         style="z-index: -1; background-image: url('{{ asset('assets/FondoPantallaAdministrador.jpg') }}'); background-size: cover; background-repeat: no-repeat; background-attachment: fixed;">
    </div>

    {# Contenedor principal centrado vertical y horizontalmente #}
    <div class="container mt-4 d-flex justify-content-center align-items-center" style="min-height: 90vh;">
        {# Cuadro blanco translúcido con sombra y bordes redondeados #}
        <div class="bg-white bg-opacity-90 rounded-xl shadow-lg py-4 px-4 position-relative" style="z-index: 1; max-width: 500px; min-width: 350px; width: 100%;">
            {# Título de la sección #}
            <h1 class="mb-4 text-center">Crear nuevo ingrediente</h1>
            <div class="card shadow-sm">
                <div class="card-body">
                    {# Mensajes flash para notificaciones (éxito, error, etc.) #}
                    {% for label, messages in app.flashes %}
                        {% for message in messages %}
                            <div class="alert alert-{{ label }} mt-3">
                                {{ message }}
                            </div>
                        {% endfor %}
                    {% endfor %}
                    {# Formulario para crear un nuevo ingrediente #}
                    {{ form_start(form) }}
                        {{ form_row(form.nombre) }}
                        <button class="btn btn-success mt-3">Guardar</button>
                    {{ form_end(form) }}
                    {# Botón para volver al listado de ingredientes #}
                    <a href="{{ path('gestion_ingredientes') }}" class="btn btn-secondary mt-3">Volver al listado</a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}