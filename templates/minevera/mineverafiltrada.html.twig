{% extends 'base.html.twig' %}

{# Bloque de estilos: Tailwind y fondo de pantalla principal #}
{% block stylesheets %}
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <style>
        body {
            background-image: url('{{ asset('assets/FondoHomeRecitech.jpg') }}');
            background-size: cover;
            background-repeat: no-repeat;
            background-attachment: fixed;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="min-h-screen" style="background-image: url('{{ asset('assets/FondoHomeRecitech.jpg') }}'); background-size: cover; background-position: center;">
        {# Header con logo y menú de navegación #}
        <header class="sticky top-0 z-50 flex justify-between items-center p-4 bg-white shadow-md rounded-xl mx-5 mt-6">
            {# Logo y nombre #}
            <div class="flex items-center space-x-2">
                <img src="{{ asset('assets/IconoRobot.png') }}" alt="Icono Robot" class="w-12 h-12">
                <h1 class="text-lg font-semibold text-gray-700">ReciTech</h1>
            </div>
            {# Menú de navegación #}
            <nav class="flex items-center space-x-2 text-xs"> 
                <a href="/home" class="flex flex-col items-center">
                    <img src="{{ asset('assets/iconos/casa.png') }}" alt="" class="w-8 h-8">
                </a>
                <a href="/minevera" class="flex flex-col items-center">
                    <img src="{{ asset('assets/iconos/nevera.png') }}" alt="Mi Nevera" class="w-8 h-8">
                </a>
                <a href="/tiporeceta" class="flex flex-col items-center">
                    <img src="{{ asset('assets/iconos/libro-de-recetas.png') }}" alt="Recetas" class="w-8 h-8">
                </a>
                <a href="/perfil" class="ml-2">
                    <img src="{{ asset('assets/user.png') }}" alt="Foto de perfil" class="w-12 h-12 rounded-full border border-gray-300">
                </a>
            </nav>
        </header>

        <div class="container mx-auto p-6">
            {# Tarjetas de recetas filtradas #}
            <div class="space-y-8">
                {# Bucle de recetas filtradas #}
                {% for item in recetas_filtradas %}
                    {% set receta = item.receta %}
                    <a href="{{ path('ver_receta', {'id': receta.id}) }}" class="block transition-transform hover:scale-105">
                        <div class="flex flex-col md:flex-row items-center bg-white rounded-2xl shadow-lg p-8 cursor-pointer">
                            {# Imagen de la receta o marcador "Sin foto" #}
                            {% if receta.imagen %}
                                <img src="{{ asset('assets/fotorecetas/' ~ receta.imagen) }}"
                                     alt="{{ receta.nombre }}"
                                     class="w-full max-w-xs aspect-square md:w-40 md:h-40 object-cover rounded-xl mb-4 md:mb-0 md:mr-8"
                                     style="aspect-ratio: 1 / 1;">
                            {% else %}
                                <div class="w-full max-w-xs aspect-square md:w-40 md:h-40 bg-gray-200 rounded-xl flex items-center justify-center text-gray-400 text-lg mb-4 md:mb-0 md:mr-8"
                                     style="aspect-ratio: 1 / 1;">
                                    Sin foto
                                </div>
                            {% endif %}
                            <div class="flex-1 w-full">
                                {# Nombre de la receta #}
                                <h2 class="text-2xl font-bold text-gray-800 mb-2 text-center md:text-left">{{ receta.nombre }}</h2>
                                <div class="flex flex-row justify-center md:justify-start items-center space-x-6 mb-2">
                                    {# Dificultad con color #}
                                    <div class="flex items-center">
                                        {% set color = 'bg-red-500' %}
                                        {% if receta.dificultad|lower == 'fácil' or receta.dificultad|lower == 'facil' %}
                                            {% set color = 'bg-green-500' %}
                                        {% elseif receta.dificultad|lower == 'media' %}
                                            {% set color = 'bg-yellow-400' %}
                                        {% endif %}
                                        <span class="w-5 h-5 {{ color }} rounded-full mr-2"></span>
                                        <span class="text-gray-700 text-lg">{{ receta.dificultad }}</span>
                                    </div>
                                    {# Tiempo de preparación #}
                                    <div class="flex items-center text-gray-700 text-lg">
                                        <img src="{{ asset('assets/iconos/reloj.png') }}" alt="Tiempo" class="w-5 h-5 mr-1">
                                        {{ receta.tiempo }} min
                                    </div>
                                    {# Nacionalidad con icono #}
                                    <div class="flex items-center">
                                        {# Normaliza a minúsculas y sin tildes para comparar #}
                                        {% set nacionalidad = receta.nacionalidad|lower|replace({'á':'a','é':'e','í':'i','ó':'o','ú':'u'}) %}
                                        {% set icono = 'otras.png' %}
                                        {% if nacionalidad == 'sur america' %}
                                            {% set icono = 'americana.png' %}
                                        {% elseif nacionalidad == 'americana' %}
                                            {% set icono = 'americana.png' %}
                                        {% elseif nacionalidad == 'asiatica' %}
                                            {% set icono = 'asiatica.png' %}
                                        {% elseif nacionalidad == 'china' %}
                                            {% set icono = 'asiatica.png' %}
                                        {% elseif nacionalidad == 'japonesa' %}
                                            {% set icono = 'japonesa.png' %}
                                        {% elseif nacionalidad == 'española' %}
                                            {% set icono = 'española.png' %}
                                        {% elseif nacionalidad == 'francesa' %}
                                            {% set icono = 'francesa.png' %}
                                        {% elseif nacionalidad == 'italiana' %}
                                            {% set icono = 'italiana.png' %}
                                        {% elseif nacionalidad == 'mexicana' %}
                                            {% set icono = 'mexicana.png' %}
                                        {% endif %}
                                        <img src="{{ asset('assets/Nacionalidades/' ~ icono) }}" alt="Nacionalidad" class="w-5 h-5 mr-2" />
                                        <span class="text-gray-700 text-lg">{{ receta.nacionalidad }}</span>
                                    </div>
                                </div>
                                {# Ingredientes a comprar o mensaje si ya los tienes todos #}
                                <div class="text-sm text-blue-700 font-semibold text-center md:text-left">
                                    Ingredientes a comprar: {{ item.num_faltantes }}
                                    {% if item.num_faltantes > 0 %}
                                        ({{ item.faltantes|join(', ') }})
                                    {% else %}
                                        (¡Tienes todos los ingredientes!)
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </a>
                {% else %}
                    {# Mensaje si no hay recetas disponibles #}
                    <div class="text-center text-gray-500">No hay recetas disponibles.</div>
                {% endfor %}
            </div>
        </div>
    </div>
{% endblock %}

{# Bloque para scripts JS adicionales #}
{% block javascripts %}
    <script src="{{ asset('js/JSPaginaPrincipal.js') }}"></script>
{% endblock %}