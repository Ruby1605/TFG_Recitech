{% extends 'base.html.twig' %}

{% block stylesheets %}
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
      <style>
        body {
            background-image: url('{{ asset('assets/FondoHomeRecitech.jpg') }}');
            background-size: cover;
            background-repeat: no-repeat;
            background-attachment: fixed;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="min-h-screen" style="background-image: url('{{ asset('assets/FondoHomeRecitech.jpg') }}'); background-size: cover; background-position: center;">
        <!-- Header -->
        <header class="sticky top-0 z-50 flex justify-between items-center p-4 bg-white shadow-md rounded-xl mx-5 mt-6">
            <!-- Logo -->
            <div class="flex items-center space-x-2">
            <img src="{{ asset('assets/IconoRobot.png') }}" alt="Icono Robot" class="w-12 h-12">
            <a href="/home" class="text-lg font-semibold text-gray-700">ReciTech</a>
            </div>
            <!-- Menú -->
            <nav class="flex items-center space-x-3 text-xs"> <!-- space-x-3 para menos separación -->
            <a href="/home" class="flex flex-col items-center">
                <img src="{{ asset('assets/iconos/casa.png') }}" alt="" class="w-8 h-8">
            </a>
            <a href="/minevera" class="flex flex-col items-center">
                <img src="{{ asset('assets/iconos/nevera.png') }}" alt="Mi Nevera" class="w-8 h-8">
            </a>
            <span class="mx-2"></span> <!-- menos espacio aquí también -->
            <a href="/perfil">
                <img src="{{ asset('assets/user.png') }}" alt="Foto de perfil" class="w-12 h-12 rounded-full border border-gray-300">
            </a>
            </nav>
        </header>

        <!-- Contenido principal -->
        <div style="margin-top: 250px;" class="container mx-auto p-6">
            <div class="flex flex-col items-center justify-center space-y-8">
            <div class="flex flex-col md:flex-row items-center justify-center space-y-8 md:space-y-0 md:space-x-12 w-full">
                <!-- Tarjeta Difícil -->
                <a href="{{ path('filtrar_recetas', {'dificultad': 'Difícil'}) }}"
                   class="w-72 h-48 bg-gray-200 rounded-2xl shadow-lg p-8 flex flex-col justify-center items-center text-center hover:border-4 hover:border-blue-500 cursor-pointer transition-all duration-200">
                <h2 class="text-2xl font-bold text-gray-700">Difícil</h2>
                </a>
                <!-- Tarjeta Media -->
                <a href="{{ path('filtrar_recetas', {'dificultad': 'Media'}) }}"
                   class="w-72 h-48 bg-gray-200 rounded-2xl shadow-lg p-8 flex flex-col justify-center items-center text-center hover:border-4 hover:border-blue-500 cursor-pointer transition-all duration-200">
                <h2 class="text-2xl font-bold text-gray-700">Media</h2>
                </a>
                <!-- Tarjeta Fácil -->
                <a href="{{ path('filtrar_recetas', {'dificultad': 'Fácil'}) }}"
                   class="w-72 h-48 bg-gray-200 rounded-2xl shadow-lg p-8 flex flex-col justify-center items-center text-center hover:border-4 hover:border-blue-500 cursor-pointer transition-all duration-200">
                <h2 class="text-2xl font-bold text-gray-700">Fácil</h2>
                </a>
            </div>
            </div>
        </div>
    </div>
{% endblock %}