{% extends 'base.html.twig' %}

{# Título de la página #}
{% block title %}Detalle del Usuario{% endblock %}

{% block body %}
    {# Fondo de pantalla fijo para toda la página #}
    <div class="position-fixed top-0 start-0 w-100 h-100 min-vh-100 min-vw-100"
         style="z-index: -1; background-image: url('{{ asset('assets/FondoPantallaAdministrador.jpg') }}'); background-size: cover; background-repeat: no-repeat; background-attachment: fixed;">
    </div>
    {# Contenedor principal blanco translúcido y centrado #}
    <div class="container d-flex justify-content-center align-items-center" style="min-height: 100vh;">
        <div class="bg-white bg-opacity-90 rounded-xl shadow-lg py-4 px-4 position-relative" style="z-index: 1; max-width: 500px; min-width: 350px; width: 100%;">
            <div class="card shadow-sm">
                {# Cabecera de la tarjeta con título #}
                <div class="card-header bg-info text-white">
                    <h3 class="mb-0">Detalle del Usuario</h3>
                </div>
                <div class="card-body">
                    {# Lista de atributos principales del usuario #}
                    <ul class="list-group list-group-flush mb-3">
                        <li class="list-group-item"><strong>ID:</strong> {{ usuario.id }}</li>
                        <li class="list-group-item"><strong>Nombre:</strong> {{ usuario.nombre }}</li>
                        <li class="list-group-item"><strong>Email:</strong> {{ usuario.email }}</li>
                        <li class="list-group-item"><strong>Password:</strong> {{ usuario.password }}</li>
                        <li class="list-group-item"><strong>Rol:</strong> {{ usuario.rol }}</li>
                    </ul>
                    {# Botón para volver al listado de usuarios #}
                    <a href="{{ path('gestion_usuarios') }}" class="btn btn-secondary">Volver al listado</a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}